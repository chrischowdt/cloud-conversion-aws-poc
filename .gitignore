# Node
node_modules/
*.log

# Env / secrets. Ignore EVERY .env variant, not just the ones we happen to use
# today: a second tenant means a second credentials file (.env.prod, .env.stg,
# …) and the old patterns would have left those committable.
.env
.env.*
!.env.example

# Tool generated outputs (regeneratable from source)
tools/out/

# Source archives we extracted (extracted contents are tracked under reference/)
*.zip

# Python build artifacts
__pycache__/
*.pyc
*.pyo
.Python
.venv/
venv/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.iml

# Claude Code per-machine state (settings.json IS tracked — it's the project's permission allowlist)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Local scratch / working notes (not part of the deliverable)
/product feedback notes.txt
/product-ai-knowledgebase/dynatrace-*

# Workflow templates exported from a tenant. These embed live integration
# credentials in plain text (BigPanda x-app-key / x-auth-token sit in the task
# headers), so the exported file must never be committed. Keep the SHAPE of a
# workflow in code under tools/ instead, and let the tenant hold the secrets.
problem-workflow/
*.workflow-template*.yaml
*.workflow-template*.yml
