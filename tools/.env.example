# Copy to .env.local (gitignored) and fill in. The npm scripts auto-load
# this file via Node's --env-file-if-exists flag.
#
# Outputs are namespaced by tenant: every command that touches a tenant
# writes under tools/out/<env-id>/, where <env-id> is derived from
# DT_BASE_URL (https://nic55601.apps… → tools/out/nic55601/). To analyze a
# second tenant, point DT_BASE_URL/DT_TOKEN at it (or pass --base-url/--token,
# or keep a second env file and pass --env <label>) — its data lands in a
# separate folder and never overwrites the first tenant's analysis.

# Tenant URL — must be the AppEngine host. DQL endpoints
# (/platform/storage/query/v1/...) are NOT served by live.dynatrace.com.
#
# Correct:
#   https://abc12345.apps.dynatrace.com
# Wrong (will 404):
#   https://abc12345.live.dynatrace.com
DT_BASE_URL=

# Platform Token (Bearer auth). Required scopes (minimum):
#   storage:metrics:read
#
# Optional, depending on what queries you run:
#   storage:bizevents:read
#   storage:logs:read
#   storage:events:read
#   environment:roles:viewer
#
# The placement pipeline (migrate-*) additionally needs an admin document scope:
#   document:documents:read
#   document:documents:write
#   document:documents:admin      (to update/read documents owned by others)
#   document:direct-shares:write  (to share review copies with an access group)
#   document:environment-shares:write
DT_TOKEN=

# Access group that migrate-stage shares review copies with (read-write), so the
# migration team can edit them. `migrate-stage --share-group <id>` overrides this;
# if neither is set, copies fall back to an environment-wide share.
DT_SHARE_GROUP_ID=


# ─────────────────────────────────────────────────────────────────────────────
# RUNNING TWO TENANTS AT ONCE (e.g. lower + prod)
#
# Nothing is shared between tenants except the metric mapping tables, so both
# can be worked in parallel. Keep ONE credentials file per tenant:
#
#   tools/.env.local        lower
#   tools/.env.prod.local   prod
#
# Every `.env.*` is gitignored (except this example), so a prod token cannot be
# committed by accident.
#
# Select the tenant by choosing the env file — the CLI derives everything else
# from DT_BASE_URL:
#
#   node --env-file-if-exists=.env.prod.local --experimental-strip-types \
#     --no-warnings=ExperimentalWarning src/cli.ts <command> …
#
# Outputs land in tools/out/<env-id>/ (env-id comes from the URL:
# https://abc12345.apps… → tools/out/abc12345/), so the two tenants' downloads,
# scans and trackers never collide. `--env <label>` overrides the folder name if
# you prefer tools/out/prod/.
#
# THINGS THAT ARE PER-TENANT and must be re-discovered on the new tenant — none
# of them carry over, and several change the rewrite:
#   discover-tags              which AWS tags are enriched onto metrics
#   discover-metrics           live metric keys + series counts (dim-variant repair)
#   discover-users             user id → email, for the tracker's owner column
#   discover-management-zones  zone → AWS tag filter, for mzName() conversion
#
# DT_SHARE_GROUP_ID is also per-tenant: the access group id from one tenant does
# not exist in the other. Create the review group on the new tenant and put ITS
# id in that tenant's env file.
#
# The tracker defaults to tools/out/<env-id>/migration-tracker.xlsx. If you keep
# it in OneDrive, give each tenant its own file and pass --tracker.
